# ==============================================
# SENSOR MONITORING - DOCKER ENVIRONMENT
# ==============================================
# Kopiere diese Datei zu .env und fülle die Werte aus!

# Node Environment
NODE_ENV=production

# ==============================================
# BACKEND API
# ==============================================
BACKEND_PORT=5000

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# API-Key für geschützte Schreib-Endpunkte (Heizungssteuerung, Sensor-Ingestion)
# Generieren z.B. mit: openssl rand -hex 32
# Muss auf ESP32-Geräten (X-API-Key Header) und im Dashboard eingegeben werden.
API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Ziel-Komfortbereich für die Verbrauchs-Analyse (GET /api/analysis/consumption).
# Wird NICHT für die Ein/Aus-Schaltschwellen der Plugs benutzt (die stehen pro
# Plug in der Datenbank und werden im Dashboard eingestellt) - nur um zu
# bewerten, ob eine Plug-Kombination den Raum tatsächlich im Zielbereich hielt.
TARGET_TEMP_MIN=18
TARGET_TEMP_MAX=22
TARGET_HUMIDITY_MIN=40
TARGET_HUMIDITY_MAX=60

# ==============================================
# FRONTEND
# ==============================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000/api

# Basic-Auth vor dem gesamten Dashboard (nginx auth_basic, siehe
# frontend/docker-entrypoint.sh) - ohne diese beiden Werte startet der
# Frontend-Container absichtlich nicht (fail-safe statt offen).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# ==============================================
# MONGODB
# ==============================================
MONGO_PORT=27017
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=sicheres_passwort_hier
MONGO_DB_NAME=sensor_monitoring

# ==============================================
# NGINX PROXY MANAGER
# ==============================================
# Nginx Proxy Manager Admin UI läuft auf Port 81
# Standard Login:
#   Email: admin@example.com
#   Password: changeme
# 
# WICHTIG: Ändere das Passwort nach dem ersten Login!

# ==============================================
# PRODUCTION SETTINGS
# ==============================================
# Für Production diese Werte anpassen:
# NODE_ENV=production
# CORS_ORIGIN=https://yourdomain.com
# VITE_API_URL=https://api.yourdomain.com/api
# Starke Passwörter für MongoDB verwenden!

